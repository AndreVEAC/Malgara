  "eventos": {
    "n2_entrada_normal": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "¿Los siguieron?"
        },
        {
          "hablante": "Lucas",
          "texto": "Hola a ti también."
        },
        {
          "hablante": "Mateo",
          "texto": "A mí no. Creo."
        },
        {
          "hablante": "Morales",
          "texto": "Procura estar seguro la próxima vez."
        }
      ]
    },
    "n2_entrada_rescate": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "No se acerquen a las ventanas."
        },
        {
          "hablante": "Lucas",
          "texto": "¿De verdad lo encerraron?"
        },
        {
          "hablante": "Mateo",
          "texto": "No quiero volver a hablar de eso ahora."
        },
        {
          "hablante": "Morales",
          "texto": "Pues recuerda cómo se siente antes de volver a preguntar demasiado."
        }
      ]
    },
    "n2_correccion_oficina": {
      "lineas": [
        {
          "hablante": "Lucas",
          "texto": "Revisé las fotos. La caja J. M. está en la oficina municipal, junto a la iglesia. Vi una entrada de servicio."
        }
      ]
    },
    "n2_pregunta_lucas": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "¿Encontraste algo, Lucas?"
        }
      ]
    },
    "n2_caja_colabora": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "En los papeles de mi abuela aparecía una caja de madera. Marcada con las letras J. M."
        },
        {
          "hablante": "Lucas",
          "texto": "Espera. Yo vi esa caja."
        },
        {
          "hablante": "Mateo",
          "texto": "¿Dónde?"
        },
        {
          "hablante": "Lucas",
          "texto": "En la oficina municipal, junto a la iglesia. Me dejaron fotografiar unos libros viejos."
        },
        {
          "hablante": "Lucas",
          "texto": "La caja estaba al lado. Mira, sale aquí."
        },
        {
          "hablante": "Mateo",
          "texto": "El inventario dice que guardaban dentro la llave del pasadizo."
        },
        {
          "hablante": "Lucas",
          "texto": "Fotografío la caja y dejo la llave. Un día productivo."
        },
        {
          "hablante": "Morales",
          "texto": "Álvarez está organizando los preparativos desde esa oficina. No será fácil entrar."
        },
        {
          "hablante": "Lucas",
          "texto": "Hay una entrada de servicio. Vi salir a un hombre por ahí."
        }
      ]
    },
    "n2_tres_pistas": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "Los libros venían de la parroquia. Y sabemos cómo reconocer la llave: tiene una muesca de media luna."
        },
        {
          "hablante": "Morales",
          "texto": "Entonces ya tienen algo concreto que buscar."
        }
      ]
    },
    "n2_pistas_incompletas": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "Pero no conseguí aclarar todo lo demás."
        },
        {
          "hablante": "Morales",
          "texto": "Puede ser esa caja. También puede que el inventario esté desactualizado."
        },
        {
          "hablante": "Lucas",
          "texto": "Preferiría estar un poco más seguro antes de meterme donde trabaja Álvarez."
        }
      ]
    },
    "n2_lucas_no_colabora": {
      "lineas": [
        {
          "hablante": "Lucas",
          "texto": "Vi gente entrando y saliendo de la oficina municipal. Poco más."
        },
        {
          "hablante": "Mateo",
          "texto": "¿No pudiste acercarte?"
        },
        {
          "hablante": "Lucas",
          "texto": "Pude. También pude llamar la atención. Preferí no hacerlo."
        },
        {
          "hablante": "Mateo",
          "texto": "Necesitamos saber qué está pasando."
        },
        {
          "hablante": "Lucas",
          "texto": "Y yo necesito seguir vivo para enterarme."
        }
      ]
    },
    "n2_sin_caja_colabora": {
      "lineas": [
        {
          "hablante": "Lucas",
          "texto": "Me dejaron fotografiar unos libros antiguos en la oficina municipal."
        },
        {
          "hablante": "Mateo",
          "texto": "¿Algo sobre la iglesia?"
        },
        {
          "hablante": "Lucas",
          "texto": "No pude leerlos con el encargado respirándome en la nuca."
        },
        {
          "hablante": "Morales",
          "texto": "Entonces todavía no sabemos dónde buscar la llave."
        }
      ]
    },
    "n2_carta_hallazgo": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "Espera…"
        },
        {
          "hablante": "Lucas",
          "texto": "¿Qué?"
        },
        {
          "hablante": "Mateo",
          "texto": "Hay algo aquí."
        },
        {
          "hablante": "Lucas",
          "texto": "No me digas que es otro papel."
        }
      ]
    },
    "n2_carta_lectura": {
      "lineas": [
        {
          "hablante": "Carta",
          "texto": "Esta noche irán a buscarlos."
        },
        {
          "hablante": "Carta",
          "texto": "Salgan cuando oscurezca, antes de que empiecen las rondas. No vuelvan a esa casa."
        },
        {
          "hablante": "Carta",
          "texto": "Al amanecer estaré en la clínica. Entren por detrás. Puedo ayudarlos a salir del pueblo."
        },
        {
          "hablante": "Carta",
          "texto": "No intenten encontrarme antes. No puedo dejar que me vean con ustedes."
        }
      ]
    },
    "n2_confesion_cartas": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "Sabe dónde estamos."
        },
        {
          "hablante": "Lucas",
          "texto": "Eso ya lo sabe medio pueblo. Lo preocupante es que haya entrado."
        },
        {
          "hablante": "Morales",
          "texto": "¿Por qué dijiste «otro papel»?"
        },
        {
          "hablante": "Mateo",
          "texto": "No es la primera carta que recibimos."
        },
        {
          "hablante": "Morales",
          "texto": "¿Desde cuándo?"
        },
        {
          "hablante": "Mateo",
          "texto": "Desde que llegamos. Una nos llevó a mirar detrás de la placa de la estatua."
        },
        {
          "hablante": "Morales",
          "texto": "¿Y decidieron no contármelo?"
        },
        {
          "hablante": "Lucas",
          "texto": "Tampoco sabíamos si podíamos confiar en ti."
        },
        {
          "hablante": "Morales",
          "texto": "Lo entiendo. Pero si vamos a movernos juntos, necesito saber qué los está guiando."
        },
        {
          "hablante": "Mateo",
          "texto": "Por eso te lo estamos contando ahora."
        },
        {
          "hablante": "Morales",
          "texto": "¿Alguna está firmada?"
        },
        {
          "hablante": "Mateo",
          "texto": "No."
        },
        {
          "hablante": "Lucas",
          "texto": "Nuestro misterioso amigo tiene muy mala letra para presentarse."
        },
        {
          "hablante": "Morales",
          "texto": "Puede estar ayudándolos. O puede querer que salgan por una puerta concreta."
        },
        {
          "hablante": "Mateo",
          "texto": "Pero la información de la estatua era cierta."
        },
        {
          "hablante": "Morales",
          "texto": "Sí. Eso cuenta a su favor. No lo demuestra todo."
        }
      ],
      "efectos_al_terminar": {
        "morales_conoce_cartas": true
      }
    },
    "n2_decision_intro": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "Si nos quedamos y la carta dice la verdad, nos encontrarán aquí."
        },
        {
          "hablante": "Morales",
          "texto": "Esta casa ya no nos sirve."
        },
        {
          "hablante": "Lucas",
          "texto": "Me estaba empezando a acostumbrar a no morir dentro."
        }
      ]
    },
    "n2_elegir_destino": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "Tenemos dos posibilidades. Buscar a esa persona en la clínica o conseguir la llave e investigar el pasadizo."
        },
        {
          "hablante": "Lucas",
          "texto": "Una cita con un desconocido o entrar donde está Álvarez. Qué difícil elegir."
        }
      ],
      "opciones": [
        {
          "texto": "Buscar ayuda en la clínica.",
          "siguiente": "n2_plan_clinica",
          "efectos": {
            "plan_dia3": "clinica"
          }
        },
        {
          "texto": "Conseguir la llave e investigar el pasadizo.",
          "siguiente": "n2_plan_oficina",
          "efectos": {
            "plan_dia3": "oficina"
          }
        }
      ],
