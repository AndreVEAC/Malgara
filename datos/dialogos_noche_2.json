    },
    "n2_plan_clinica": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "Quiero salir de aquí. Si esa persona puede ayudarnos, tenemos que intentarlo."
        },
        {
          "hablante": "Morales",
          "texto": "Bien. Al amanecer iremos a la parte de atrás de la clínica."
        },
        {
          "hablante": "Lucas",
          "texto": "Una clínica. Por fin un sitio donde estar nervioso resulta normal."
        }
      ]
    },
    "n2_plan_oficina": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "Encontramos esas pistas por algo. Quiero saber qué hay bajo la iglesia."
        },
        {
          "hablante": "Lucas",
          "texto": "Yo preferiría descubrirlo desde bastante lejos."
        },
        {
          "hablante": "Morales",
          "texto": "Primero la llave. Sin ella no hay ningún pasadizo."
        },
        {
          "hablante": "Mateo",
          "texto": "Entonces iremos a la oficina municipal."
        }
      ]
    },
    "n2_plan_unico": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "No conseguimos lo necesario para encontrar la llave."
        },
        {
          "hablante": "Morales",
          "texto": "Nos queda la persona de la clínica."
        },
        {
          "hablante": "Lucas",
          "texto": "Pues esperemos que sepa sacarnos de aquí."
        },
        {
          "hablante": "Mateo",
          "texto": "Iremos al amanecer."
        }
      ],
      "efectos_al_terminar": {
        "plan_dia3": "clinica"
      }
    },
    "n2_refugio": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "¿Y dónde pasamos esta noche?"
        },
        {
          "hablante": "Morales",
          "texto": "En las afueras hay una caseta de mantenimiento. Llevo varias noches usándola."
        },
        {
          "hablante": "Lucas",
          "texto": "¿Tiene camas?"
        },
        {
          "hablante": "Morales",
          "texto": "Tiene una puerta que cierra."
        },
        {
          "hablante": "Lucas",
          "texto": "Casi un hotel."
        },
        {
          "hablante": "Morales",
          "texto": "Llegaremos cuando oscurezca. De día me verían cruzar el pueblo con ustedes."
        },
        {
          "hablante": "Mateo",
          "texto": "¿Y si ya están vigilando el camino?"
        },
        {
          "hablante": "Morales",
          "texto": "Por eso saldremos antes de que empiecen las rondas. Y evitaremos las calles más expuestas."
        }
      ]
    },
    "n2_cita_clinica": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "Si nos separamos, al amanecer nos encontramos detrás de la clínica."
        }
      ]
    },
    "n2_cita_oficina": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "Si nos separamos, al amanecer nos encontramos detrás de la oficina municipal."
        }
      ]
    },
    "n2_descanso": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "No vuelvan a buscarnos a esta casa."
        },
        {
          "hablante": "Mateo",
          "texto": "De acuerdo."
        },
        {
          "hablante": "Lucas",
          "texto": "Intentemos no separarnos. Por variar."
        },
        {
          "hablante": "Morales",
          "texto": "Descansen un rato. Yo vigilo."
        },
        {
          "hablante": "Mateo",
          "texto": "No creo que pueda dormir."
        },
        {
          "hablante": "Lucas",
          "texto": "Yo tampoco."
        }
      ]
    },
    "n2_despertar_negro": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "Mateo. Lucas. Despierten."
        },
        {
          "hablante": "Lucas",
          "texto": "No estaba dormido."
        },
        {
          "hablante": "Morales",
          "texto": "Claro. Levántate."
        }
      ],
      "pantalla_negra": true
    },
    "n2_despertar_visible": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "¿Ya es hora?"
        },
        {
          "hablante": "Morales",
          "texto": "Sí. La caseta está más allá de la casa de tu abuela, por detrás. Yo les indicaré al llegar."
        },
        {
          "hablante": "Lucas",
          "texto": "¿Tenemos que pasar por todo el pueblo?"
        },
        {
          "hablante": "Morales",
          "texto": "Sólo si el camino directo está cerrado."
        },
        {
          "hablante": "Mateo",
          "texto": "Vamos antes de averiguarlo."
        }
      ]
    },
    "n2_desvio": {
      "lineas": [
        {
          "hablante": "Lucas",
          "texto": "Ahí tienes la respuesta."
        },
        {
          "hablante": "Mateo",
          "texto": "Antes podíamos pasar por aquí."
        },
        {
          "hablante": "Morales",
          "texto": "Hay guardias al final del camino de arriba. Haremos el rodeo por la derecha."
        },
        {
          "hablante": "Mateo",
          "texto": "Por donde está la clínica."
        },
        {
          "hablante": "Morales",
          "texto": "Sí. Después subimos a la plaza y cruzamos hacia la casa de tu abuela."
        },
        {
          "hablante": "Lucas",
          "texto": "Un paseo nocturno. Justo lo que necesitaba."
        }
      ]
    },
    "n2_llegada_guia": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "Desde aquí voy delante."
        },
        {
          "hablante": "Mateo",
          "texto": "¿Por detrás de la casa?"
        },
        {
          "hablante": "Morales",
          "texto": "Sí. Dejé un camino de piedras para reconocer la entrada de noche."
        },
        {
          "hablante": "Lucas",
          "texto": "¿Y para que los demás también la encuentren?"
        },
        {
          "hablante": "Morales",
          "texto": "Desde el camino parecen piedras sueltas. Síganme."
        }
      ]
    },
    "n2_barda_camino": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "¿Falta mucho?"
        },
        {
          "hablante": "Morales",
          "texto": "La caseta está al otro lado de la cerca."
        },
        {
          "hablante": "Lucas",
          "texto": "Ya me conformo con que no tenga a nadie dentro."
        }
      ]
    },
    "n2_barda_cruce": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "Por aquí. Cuidado con el alambre."
        },
        {
          "hablante": "Lucas",
          "texto": "Mi ropa ya estaba demasiado entera."
        }
      ]
    },
    "n2_agarre": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "¡Suéltame!"
        },
        {
          "hablante": "Mateo",
          "texto": "¡Lucas! ¡Morales!"
        }
      ]
    },
    "n2_ambos_regreso": {
      "lineas": [
        {
          "hablante": "Lucas",
          "texto": "¡Lo tiene agarrado!"
        },
        {
          "hablante": "Morales",
          "texto": "¡Voy! Lucas, deja libre el paso."
        }
      ]
    },
    "n2_ambos_caida": {
      "lineas": [
        {
          "hablante": "Lucas",
          "texto": "¡Mateo, por aquí!"
        },
        {
          "hablante": "Morales",
          "texto": "¡Levántate!"
        }
      ]
    },
    "n2_ambos_separacion": {
      "lineas": [
        {
          "hablante": "Lucas",
          "texto": "¡No va a poder pasar!"
        },
        {
          "hablante": "Morales",
          "texto": "¡Mateo, vuelve por donde vinimos!"
        },
        {
          "hablante": "Mateo",
          "texto": "¡Pero ustedes…!"
        },
        {
          "hablante": "Lucas",
          "texto": "¡Corre! ¡Nos vemos donde quedamos!"
        }
      ]
    },
    "n2_lucas_regreso": {
      "lineas": [
        {
          "hablante": "Lucas",
          "texto": "¡Morales, ayúdame!"
        },
        {
          "hablante": "Morales",
          "texto": "¡Vienen más! ¡Tenemos que irnos!"
        },
        {
          "hablante": "Lucas",
          "texto": "¡No voy a dejarlo!"
        }
      ]
    },
    "n2_lucas_caida": {
      "lineas": [
        {
          "hablante": "Lucas",
          "texto": "¡Arriba, idiota! ¡Corre!"
        }
      ]
    },
    "n2_lucas_separacion": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "¡Lucas!"
        },
        {
          "hablante": "Lucas",
          "texto": "¡Por atrás! ¡No intentes cruzar!"
        },
        {
          "hablante": "Mateo",
          "texto": "¿Y tú?"
        },
        {
          "hablante": "Lucas",
          "texto": "¡Nos vemos donde quedamos! ¡Muévete!"
        }
      ]
    },
    "n2_morales_regreso": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "¡Lucas, espera aquí!"
        },
        {
          "hablante": "Lucas",
          "texto": "No… no puedo quedarme."
        }
      ]
    },
    "n2_morales_caida": {
      "lineas": [
        {
          "hablante": "Morales",
          "texto": "¡Mateo, levántate!"
        }
      ]
    },
    "n2_morales_separacion": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "¡No puedo pasar!"
        },
        {
          "hablante": "Morales",
          "texto": "¡Da la vuelta! ¡El camino de atrás sigue libre!"
        },
        {
          "hablante": "Mateo",
          "texto": "¿Dónde está Lucas?"
        },
        {
          "hablante": "Morales",
          "texto": "¡Ahora no! ¡Nos vemos donde acordamos!"
        }
      ]
    },
    "n2_ninguno_abandono": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "¡Ayúdenme!"
        },
        {
          "hablante": "Lucas",
          "texto": "Morales…"
        },
        {
          "hablante": "Morales",
          "texto": "Vienen más."
        },
        {
          "hablante": "Mateo",
          "texto": "¡Todavía pueden sacarme!"
        },
        {
          "hablante": "Lucas",
          "texto": "Yo… no puedo."
        }
      ]
    },
    "n2_ninguno_final": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "¡No! ¡Esperen!"
        }
      ]
    },
    "n2_prision": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "Se fueron…"
        },
        {
          "hablante": "Mateo",
          "texto": "Los dos."
        }
      ]
    },
    "n2_prision_reincidente": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "Esta vez saben por dónde me sacaron."
        }
      ],
      "requiere": "rescate_diurno_completado"
    },
    "n2_prision_cierre": {
      "lineas": [
        {
          "hablante": "Mateo",
          "texto": "Tengo que encontrar otra salida."
        },
        {
          "hablante": "Voz",
          "texto": "No te canses. Mañana vendrán por ti."
        }
      ],
      "efectos_al_terminar": {
