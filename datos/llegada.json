{
  "evento_llegada_1": {
    "lineas": [
      { "hablante": "Lucas", "texto": "Bueno, al menos ya encontramos una casa." },
      { "hablante": "Mateo", "texto": "Debemos estar cerca." },
      { "hablante": "Lucas", "texto": "Eso espero." },
      { "hablante": "Lucas", "texto": "Mis pies ya están considerando abandonarme." },
      { "hablante": "Abuela", "texto": "¡Vaya! ¿Visitantes?" },
      { "hablante": "Mateo", "texto": "Buenas tardes, señora." },
      { "hablante": "Abuela", "texto": "Buenas tardes, muchachos." },
      { "hablante": "Abuela", "texto": "Qué sorpresa ver caras nuevas por aquí." },
      { "hablante": "Abuela", "texto": "No solemos recibir muchas visitas." },
      { "hablante": "Lucas", "texto": "Pues créame que tampoco es muy sencillo llegar." },
      { "hablante": "Abuela", "texto": "¡Ja, ja! Eso me imagino. ¿Vienen de muy lejos?" },
      { "hablante": "Mateo", "texto": "Un poco. Estamos buscando Malgara." },
      { "hablante": "Abuela", "texto": "Pues llegaron al lugar correcto, muchacho." },
      { "hablante": "Abuela", "texto": "Esta es la primera casa del pueblo." },
      { "hablante": "Abuela", "texto": "Espera un momento..." }
    ]
  },
  "evento_llegada_2": {
    "lineas": [
      { "hablante": "Abuela", "texto": "Qué curioso..." },
      { "hablante": "Mateo", "texto": "¿Sucede algo?" },
      { "hablante": "Abuela", "texto": "Disculpa que te mire así, hijo, pero..." },
      { "hablante": "Abuela", "texto": "Te pareces muchísimo a alguien que conocí hace muchos años." },
      { "hablante": "Mateo", "texto": "¿Ah, sí?" },
      { "hablante": "Abuela", "texto": "A mi hija, cuando era joven." },
      { "hablante": "Mateo", "texto": "¿Su hija?" },
      { "hablante": "Abuela", "texto": "Sí... Sobre todo los ojos. Son exactamente iguales." },
      { "hablante": "Mateo", "texto": "Disculpe, ¿cómo se llamaba su hija?" },
      { "hablante": "Abuela", "texto": "Elena." },
      { "hablante": "Mateo", "texto": "...Ese era el nombre de mi madre." },
      { "hablante": "Abuela", "texto": "¿Qué...?" },
      { "hablante": "Mateo", "texto": "Mi madre nació aquí, en Malgara." },
      { "hablante": "Abuela", "texto": "Dios mío..." },
      { "hablante": "Abuela", "texto": "¿Tú eres Mateo?" },
      { "hablante": "Mateo", "texto": "Sí, señora." },
      { "hablante": "Abuela", "texto": "¡Mateo! ¡Mi niño!" },
      { "hablante": "Mateo", "texto": "¿Usted es...?" },
      { "hablante": "Abuela", "texto": "¡Tu abuela, hijo! ¡Soy tu abuela!" },
      { "hablante": "Mateo", "texto": "No puedo creerlo..." },
      { "hablante": "Abuela", "texto": "Mírate nada más... Estás hecho un hombre." },
      { "hablante": "Mateo", "texto": "Mi madre me había hablado de usted." },
      { "hablante": "Abuela", "texto": "¿De verdad?" },
      { "hablante": "Mateo", "texto": "Sí. Me contó algunas cosas de su infancia, de esta casa..." },
      { "hablante": "Mateo", "texto": "...aunque nunca llegamos a venir." },
      { "hablante": "Abuela", "texto": "Ay, hijo... Cuánto me habría gustado volver a verla." },
      { "hablante": "Mateo", "texto": "Ella también quería regresar." },
      { "hablante": "Abuela", "texto": "Lo sé, hijo. Lo sé..." },
      { "hablante": "Lucas", "texto": "Bueno... creo que este es el momento en que debería presentarme." },
      { "hablante": "Abuela", "texto": "¡Ay, perdóname, muchacho!" },
      { "hablante": "Abuela", "texto": "Con la emoción me olvidé por completo de ti." },
      { "hablante": "Lucas", "texto": "No se preocupe." },
      { "hablante": "Lucas", "texto": "Yo también estaría emocionado si encontrara a mi nieto." },
      { "hablante": "Mateo", "texto": "Él es Lucas. Nos conocimos en el camino." },
      { "hablante": "Lucas", "texto": "Fotógrafo y viajero involuntario." },
      { "hablante": "Abuela", "texto": "¡Ja, ja, ja! Pues mucho gusto, Lucas." },
      { "hablante": "Abuela", "texto": "Los dos son bienvenidos aquí." },
      { "hablante": "Abuela", "texto": "Ay, pero mírate... Debes estar cansadísimo." },
      { "hablante": "Abuela", "texto": "¿Ya comiste algo?" },
      { "hablante": "Mateo", "texto": "No desde hace varias horas." },
      { "hablante": "Lucas", "texto": "Yo tampoco, por si sirve de algo." },
      { "hablante": "Abuela", "texto": "¡Pero qué barbaridad!" },
      { "hablante": "Abuela", "texto": "No pueden andar por ahí con el estómago vacío." },
      { "hablante": "Abuela", "texto": "¡Hay que alimentarlos bien!" },
      { "hablante": "Abuela", "texto": "¿Saben qué?" },
      { "hablante": "Abuela", "texto": "Voy a avisarle a todo el mundo que tenemos visitas." },
      { "hablante": "Abuela", "texto": "¡Tenemos que darles una bienvenida como se merecen!" },
      { "hablante": "Mateo", "texto": "¡No es necesario!" },
      { "hablante": "Abuela", "texto": "¡Tonterías!" },
      { "hablante": "Abuela", "texto": "¡No todos los días regresa alguien de la familia!" },
      { "hablante": "Lucas", "texto": "Bueno, una comida de bienvenida tampoco suena tan mal..." },
      { "hablante": "Lucas", "texto": "¿Qué? Llevamos horas caminando." },
      { "hablante": "Abuela", "texto": "¡Eso es! ¡Voy a decirles que preparen algo especial!" }
    ]
  },
  "evento_llegada_3": {
    "lineas": [
      { "hablante": "Lucas", "texto": "..." },
      { "hablante": "Mateo", "texto": "¿Qué?" },
      { "hablante": "Lucas", "texto": "Creo que acabas de convertirnos en invitados de honor." },
      { "hablante": "Mateo", "texto": "No exageres." },
      { "hablante": "Lucas", "texto": "¿Exagerar?" },
      { "hablante": "Lucas", "texto": "Tu abuela acaba de organizar una fiesta en menos de dos minutos." },
      { "hablante": "Mateo", "texto": "Siempre fue muy entusiasta, según mi madre." },
      { "hablante": "Lucas", "texto": "Pues me cae bien." },
      { "hablante": "Lucas", "texto": "Bueno, un banquete nos espera, ¡vamos!" }
    ]
  },
  "evento_pozo": {
  "lineas": [
    { "hablante": "Mateo", "texto": "Un pozo profundo." },
    { "hablante": "Mateo", "texto": "El agua debe estar muy abajo." }
  ]
  }
}